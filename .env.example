# Supabase (Phase 1: server-side, service-role access only — no auth yet)
# Copy this file to .env.local and fill in the values from your Supabase project.

# YouTube Data API key (server-side only)
YOUTUBE_API_KEY=

# Google Gemini API key (server-side only)
GEMINI_API_KEY=

# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (browser-safe; used by client auth in Phase 2)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_,
# never import into client code. It bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=
